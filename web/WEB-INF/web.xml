<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
    
    <!-- 登录Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.jisu.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    
    <!-- 用户Servlet -->
    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>com.jisu.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/user</url-pattern>
    </servlet-mapping>
    
    <!-- 作品Servlet -->
    <servlet>
        <servlet-name>WorksServlet</servlet-name>
        <servlet-class>com.jisu.WorksServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WorksServlet</servlet-name>
        <url-pattern>/works</url-pattern>
    </servlet-mapping>
    
    <!-- 留言Servlet -->
    <servlet>
        <servlet-name>MessageServlet</servlet-name>
        <servlet-class>com.jisu.MessageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MessageServlet</servlet-name>
        <url-pattern>/message</url-pattern>
    </servlet-mapping>
    
    <!-- 歌手信息Servlet -->
    <servlet>
        <servlet-name>InfoServlet</servlet-name>
        <servlet-class>com.jisu.InfoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InfoServlet</servlet-name>
        <url-pattern>/info</url-pattern>
    </servlet-mapping>
    
    <!-- 管理员Servlet -->
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.jisu.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
    </servlet-mapping>
    
    <!-- 退出登录Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.jisu.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    
    <!-- 下载Servlet -->
    <servlet>
        <servlet-name>DownloadServlet</servlet-name>
        <servlet-class>com.jisu.DownloadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DownloadServlet</servlet-name>
        <url-pattern>/download</url-pattern>
    </servlet-mapping>
    
    <!-- 视频流Servlet -->
    <servlet>
        <servlet-name>VideoServlet</servlet-name>
        <servlet-class>com.jisu.VideoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VideoServlet</servlet-name>
        <url-pattern>/video/stream</url-pattern>
    </servlet-mapping>
    
    <!-- 修改密码Servlet -->
    <servlet>
        <servlet-name>ModifyPwdServlet</servlet-name>
        <servlet-class>com.jisu.ModifyPwdServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ModifyPwdServlet</servlet-name>
        <url-pattern>/modifyPwd</url-pattern>
    </servlet-mapping>
    
    <!-- 重置密码Servlet -->
    <servlet>
        <servlet-name>ResetPwdServlet</servlet-name>
        <servlet-class>com.jisu.ResetPwdServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResetPwdServlet</servlet-name>
        <url-pattern>/resetPwd</url-pattern>
    </servlet-mapping>
    
    <!-- 上传Servlet -->
    <servlet>
        <servlet-name>UploadServlet</servlet-name>
        <servlet-class>com.jisu.UploadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UploadServlet</servlet-name>
        <url-pattern>/upload</url-pattern>
    </servlet-mapping>
    
    <!-- 图片Servlet -->
    <servlet>
        <servlet-name>ImageServlet</servlet-name>
        <servlet-class>com.jisu.ImageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ImageServlet</servlet-name>
        <url-pattern>/images/*</url-pattern>
    </servlet-mapping>
    
    <!-- 错误页面配置 -->
    <error-page>
        <error-code>404</error-code>
        <location>/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
    
    <!-- 默认首页 -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>